<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.edu.mapper.TeacherMapper">
    
    <resultMap type="Teacher" id="TeacherResult">
        <result property="teacherId"    column="teacher_id"    />
        <result property="teacherNo"    column="teacher_no"    />
        <result property="teacherName"    column="teacher_name"    />
        <result property="gender"    column="gender"    />
        <result property="birthday"    column="birthday"    />
        <result property="education"    column="education"    />
        <result property="title"    column="title"    />
        <result property="deptId"    column="dept_id"    />
        <result property="userId"    column="user_id"    />
        <result property="introduction"    column="introduction"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"    column="remark"    />
        <association property="dept" javaType="Department">
            <result property="deptId"    column="d_dept_id"    />
            <result property="deptCode"    column="d_dept_code"    />
            <result property="deptName"    column="d_dept_name"    />
        </association>
    </resultMap>

    <sql id="selectTeacherVo">
        select t.teacher_id, t.teacher_no, t.teacher_name, t.gender, t.birthday, t.education, t.title, t.dept_id, t.user_id, t.introduction, 
               t.create_by, t.create_time, t.update_by, t.update_time, t.remark,
               d.dept_id as d_dept_id, d.dept_code as d_dept_code, d.dept_name as d_dept_name
        from edu_teacher t
        left join edu_department d on t.dept_id = d.dept_id
    </sql>

    <select id="selectTeacherList" parameterType="Teacher" resultMap="TeacherResult">
        <include refid="selectTeacherVo"/>
        <where>  
            <if test="teacherNo != null  and teacherNo != ''"> and t.teacher_no like concat('%', #{teacherNo}, '%')</if>
            <if test="teacherName != null  and teacherName != ''"> and t.teacher_name like concat('%', #{teacherName}, '%')</if>
            <if test="gender != null  and gender != ''"> and t.gender = #{gender}</if>
            <if test="deptId != null "> and t.dept_id = #{deptId}</if>
        </where>
    </select>
    
    <select id="selectTeacherByTeacherId" parameterType="Long" resultMap="TeacherResult">
        <include refid="selectTeacherVo"/>
        where t.teacher_id = #{teacherId}
    </select>
    
    <select id="selectTeacherByUserId" parameterType="Long" resultMap="TeacherResult">
        <include refid="selectTeacherVo"/>
        where t.user_id = #{userId}
    </select>
        
    <insert id="insertTeacher" parameterType="Teacher" useGeneratedKeys="true" keyProperty="teacherId">
        insert into edu_teacher
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="teacherNo != null and teacherNo != ''">teacher_no,</if>
            <if test="teacherName != null and teacherName != ''">teacher_name,</if>
            <if test="gender != null">gender,</if>
            <if test="birthday != null">birthday,</if>
            <if test="education != null">education,</if>
            <if test="title != null">title,</if>
            <if test="deptId != null">dept_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="introduction != null">introduction,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="teacherNo != null and teacherNo != ''">#{teacherNo},</if>
            <if test="teacherName != null and teacherName != ''">#{teacherName},</if>
            <if test="gender != null">#{gender},</if>
            <if test="birthday != null">#{birthday},</if>
            <if test="education != null">#{education},</if>
            <if test="title != null">#{title},</if>
            <if test="deptId != null">#{deptId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="introduction != null">#{introduction},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateTeacher" parameterType="Teacher">
        update edu_teacher
        <trim prefix="SET" suffixOverrides=",">
            <if test="teacherNo != null and teacherNo != ''">teacher_no = #{teacherNo},</if>
            <if test="teacherName != null and teacherName != ''">teacher_name = #{teacherName},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="education != null">education = #{education},</if>
            <if test="title != null">title = #{title},</if>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="introduction != null">introduction = #{introduction},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where teacher_id = #{teacherId}
    </update>

    <delete id="deleteTeacherByTeacherId" parameterType="Long">
        delete from edu_teacher where teacher_id = #{teacherId}
    </delete>

    <delete id="deleteTeacherByTeacherIds" parameterType="Long">
        delete from edu_teacher where teacher_id in 
        <foreach item="teacherId" collection="array" open="(" separator="," close=")">
            #{teacherId}
        </foreach>
    </delete>

    <select id="countAll" resultType="int">
        select count(0) from edu_teacher
    </select>

    <select id="selectTeacherByGh" parameterType="String" resultMap="TeacherResult">
        <include refid="selectTeacherVo"/>
        where t.teacher_no = #{gh}
    </select>
</mapper>
